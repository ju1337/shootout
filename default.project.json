{
  "name": "Shootout",
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "$ignoreUnknownInstances": true,
      "$path": "src/first"
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "$ignoreUnknownInstances": true,
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true,
        "Weapons": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "Rifle": {
            "$path": "models/Weapons/Rifle.rbxm",
            "$ignoreUnknownInstances": true
          }
        },
        "Attachments": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true,
          "HoloSight": {
            "$path": "models/Attachments/HoloSight.rbxm"
          },
          "Suppressor": {
            "$path": "models/Attachments/Suppressor.rbxm"
          },
          "AngledGrip": {
            "$path": "models/Attachments/AngledGrip.rbxm"
          }
        },
        "Agents": {
          "$className": "Folder",
          "$ignoreUnknownInstances": true
        }
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "ServerShared": {
        "$path": "src/server-shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$ignoreUnknownInstances": true,
      "$path": "src/server"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$ignoreUnknownInstances": true,
        "$path": "src/client"
      }
    },
    "Players": {
      "$className": "Players",
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 192,
        "StreamingTargetRadius": 1024,
        "StreamOutBehavior": "Opportunistic",
        "StreamingIntegrityMode": "MinimumRadiusPause"
      },
      "Maps": {
        "$path": "src/maps"
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ClockTime": 17.4,
        "Brightness": 2.6,
        "EnvironmentDiffuseScale": 1,
        "EnvironmentSpecularScale": 1,
        "OutdoorAmbient": [
          0.45,
          0.42,
          0.5
        ],
        "Ambient": [
          0.25,
          0.24,
          0.3
        ],
        "ExposureCompensation": 0.15
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.28,
          "Offset": 0.15,
          "Haze": 1.6,
          "Glare": 0.6,
          "Color": [
            0.85,
            0.7,
            0.6
          ],
          "Decay": [
            0.45,
            0.38,
            0.5
          ]
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": {
          "Intensity": 0.3,
          "Size": 24,
          "Threshold": 1.6
        }
      },
      "ColorCorrection": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Saturation": -0.08,
          "Contrast": 0.12,
          "TintColor": [
            1,
            0.98,
            0.95
          ]
        }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": {
          "Intensity": 0.05,
          "Spread": 0.6
        }
      }
    }
  }
}
