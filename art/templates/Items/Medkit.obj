v -0.700000 1.000000 0.225000
v 0.700000 0.000000 -0.225000
v 0.700000 0.000000 0.225000
v 0.700000 1.000000 -0.225000
v 0.700000 1.000000 0.225000
usemtl c_969ca6_35
f 1 2 4 3
f 5 7 8 6
f 1 5 6 2
f 3 4 8 7
f 1 3 7 5
f 2 6 8 4
