-- Rote-Zone-Punkte (RedPointsService) und der Schieber (Stand_Red): kauft nur gegen RZ (eigene Preise, auch Aufsätze),
-- ohne genug RZ geht nichts, Münzen bleiben unberührt; RZ werden gespeichert und als Attribut gezeigt.
local failures = 0
local function check(cond, msg)
	if not cond then
		failures += 1
		print("FEHLER: " .. msg)
	end
end
local function step(seconds)
	SIM.Advance(seconds or 1, 20) -- mit Heartbeat (Safe-Zone-Prüfung, Magazin-Abgleich)
end

game.JobId = "server-1"
local store = SIM.DataStore("PlayerData_v1")
local HttpService = game:GetService("HttpService")
local Remotes = require("Remotes")
